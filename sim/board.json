{
  "name": "DAQ-Board",
  "architecture": "stm32u5",
  "mcu": "stm32u585",
  "memory": {
    "flash_base": 134217728,
    "flash_size": 2097152,
    "ram_regions": [
      {"name": "sram", "base": 536870912, "size": 786432}
    ],
    "bootloader_size": 32768,
    "slot_a_base": 134250496,
    "slot_a_size": 1900544,
    "erase_size": 8192,
    "write_alignment": 16,
    "sedsnet_pool": 4096,
    "delta_base": 136151040,
    "delta_size": 131072
  },
  "artifacts": {
    "elf": "build/Release_Script/DAQ-Board.elf",
    "bootloader_elf": "build/Release_Script/DAQ-BoardBootloader.elf",
    "firmware": "build/Release_Script/DAQ-Board.launchcore.img",
    "bootloader": "build/Release_Script/DAQ-BoardBootloader.bin",
    "factory": "build/Release_Script/DAQ-Board.factory.bin",
    "ota": "build/Release_Script/DAQ-Board.seds"
  },
  "board": {
    "strict_mmio": false,
    "clocks": [],
    "connections": [{"from": "gpio.28", "to": "layoutDevice2@0"}],
    "pins": [],
    "dma_routes": [
      {"request": "spi2.DMARecieve", "controller": "gpdma", "channel": 0},
      {"request": "spi2.DMATransmit", "controller": "gpdma", "channel": 1}
    ],
    "security": {"trustzone": false, "secure_regions": []}
  },
  "traffic": {
    "iterations": 100000,
    "max_payload": 512,
    "queue_depth": 0,
    "immediate_dispatch": true
  },
  "ota": {
    "chunk_size": 512
  },
  "peripherals": [
    {
      "type": "adc",
      "name": "adc1",
      "model": "stm32_adc",
      "bus": "adc1",
      "bits": 14,
      "channels": 12,
      "channel_samples": [8192, 8192, 8192, 8192, 8192, 10900, 8192, 8300, 8192, 8192, 8192, 9000],
      "noise_lsb": 4
    },
    {
      "type": "adc",
      "name": "adc4",
      "model": "stm32_adc",
      "bus": "adc4",
      "bits": 12,
      "channels": 4,
      "channel_samples": [512, 1536, 2560, 3584],
      "noise_lsb": 2
    },
    {
      "type": "adc",
      "name": "loadcell_adc",
      "model": "mcp3564r",
      "bus": "spi2",
      "bits": 24,
      "channels": 1,
      "channel_samples": [1048576]
    },
    {
      "type": "storage",
      "name": "sd_card",
      "model": "sd_card",
      "bus": "sdmmc1",
      "capacity_bytes": 1073741824
    }
  ],
  "execution": {
    "factory_boot_success_symbol": "_tx_thread_schedule",
    "virtual_time_ms": 2000,
    "sample_count": 10,
    "memory_probe_warmup_samples": 4,
    "require_stack_probe": true,
    "memory_probes": [
      {"name": "network_ready", "symbol": "g_telemetry_network_ready"},
      {"name": "peer_mask", "symbol": "g_telemetry_peer_mask"},
      {"name": "heartbeat_attempts", "symbol": "g_sim_heartbeat_attempts"},
      {"name": "heartbeat_ok", "symbol": "g_sim_heartbeat_ok"},
      {"name": "heartbeat_wire_tx", "symbol": "g_sim_heartbeat_wire_tx"},
      {"name": "heartbeat_fail", "symbol": "g_sim_heartbeat_fail"},
      {"name": "discovery_seen", "symbol": "g_telemetry_discovery_seen"},
      {"name": "timesync_valid", "symbol": "g_telemetry_timesync_valid"},
      {"name": "fdcan_rx", "symbol": "g_fdcan_rx_count"},
      {"name": "fdcan_tx_ok", "symbol": "g_fdcan_tx_ok_count"},
      {"name": "fdcan_tx_fail", "symbol": "g_fdcan_tx_fail_count", "maximum": 0},
      {"name": "daq_samples", "symbol": "g_daq_sample_ok_count", "minimum": 3},
      {"name": "daq_sample_overruns", "symbol": "g_daq_sample_overrun_count", "maximum": 0},
      {"name": "daq_thread_create_status", "symbol": "g_daq_thread_create_status"},
      {"name": "daq_sample_failures", "symbol": "g_daq_sample_fail_count"},
      {"name": "daq_init_failures", "symbol": "g_daq_init_fail_count"},
      {"name": "daq_init_status", "symbol": "g_daq_board_init_status"},
      {"name": "daq_sample_status", "symbol": "g_daq_board_sample_status"},
      {"name": "daq_adc1_read_status", "symbol": "g_daq_adc1_read_status"},
      {"name": "daq_adc1_cr_on_error", "symbol": "g_daq_adc1_cr_on_error"},
      {"name": "daq_adc1_isr_on_error", "symbol": "g_daq_adc1_isr_on_error"},
      {"name": "daq_adc1_hal_state_on_error", "symbol": "g_daq_adc1_hal_state_on_error"},
      {"name": "mcp3564r_init_status", "symbol": "g_mcp3564r_init_status"},
      {"name": "loadcell_network_rows", "symbol": "g_daq_loadcell_publish_ok_count", "minimum": 1},
      {"name": "loadcell_network_failures", "symbol": "g_daq_loadcell_publish_fail_count", "maximum": 0},
      {"name": "loadcell_nonzero_samples", "symbol": "g_daq_nonzero_raw_sample_count", "minimum": 1},
      {"name": "loadcell_raw_samples", "symbol": "g_daq_raw_samples_drained_count", "minimum": 1, "minimum_interval_gain": 1},
      {"name": "sd_network_rows", "symbol": "g_daq_sd_network_row_ok_count", "minimum": 1},
      {"name": "sd_network_row_failures", "symbol": "g_daq_sd_network_row_fail_count", "maximum": 0},
      {"name": "sd_ready", "symbol": "g_sd_ready", "minimum": 1},
      {"name": "sd_init_stage", "symbol": "g_sd_init_stage"},
      {"name": "sd_writer_thread_create_status", "symbol": "g_sd_writer_thread_create_status"},
      {"name": "sd_raw_records_written", "symbol": "g_sd_raw_records_written_count", "minimum": 1, "minimum_interval_gain": 1},
      {"name": "sd_csv_rows_written", "symbol": "g_sd_csv_rows_written_count", "minimum": 1},
      {"name": "sd_write_errors", "symbol": "g_sd_write_error_count", "maximum": 0},
      {"name": "sd_init_failures", "symbol": "g_sd_init_failures"},
      {"name": "sd_line_drops", "symbol": "g_sd_line_drop_count", "maximum": 0},
      {"name": "sd_raw_batch_drops", "symbol": "g_sd_raw_batch_drop_count", "maximum": 0},
      {"name": "pool_available", "symbol": "g_telemetry_pool_available", "max_end_drop": 2048},
      {"name": "telemetry_stack_remaining", "symbol": "g_telemetry_stack_remaining", "minimum": 2048},
      {"name": "pool_low_water", "symbol": "g_telemetry_pool_low_water", "minimum": 1024},
      {"name": "pool_fragments", "symbol": "g_telemetry_pool_fragments"},
      {"name": "allocations", "symbol": "g_telemetry_alloc_count"},
      {"name": "frees", "symbol": "g_telemetry_free_count"},
      {"name": "allocation_failures", "symbol": "g_telemetry_alloc_fail", "maximum": 0},
      {"name": "panics", "symbol": "g_telemetry_panic_count", "maximum": 0},
      {"name": "mutex_get_failures", "symbol": "g_telemetry_lock_get_fail", "maximum": 0},
      {"name": "mutex_put_failures", "symbol": "g_telemetry_lock_put_fail", "maximum": 0},
      {"name": "flight_state_cache", "symbol": "g_flight_state_cache_value", "maximum": 15},
      {"name": "flight_state_restores", "symbol": "g_flight_state_cache_restores"},
      {"name": "flight_state_writes", "symbol": "g_flight_state_cache_writes"},
      {"name": "flight_state_updates", "symbol": "g_flight_state_cache_updates"},
      {"name": "flight_state_errors", "symbol": "g_flight_state_cache_errors", "maximum": 0}
    ]
  }
}

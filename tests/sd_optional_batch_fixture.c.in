typedef uintptr_t ULONG;typedef unsigned UINT;typedef void VOID;typedef unsigned char UCHAR;typedef int sd_card_status_t;
enum{TX_SUCCESS=0,TX_NO_WAIT=0,FX_SUCCESS=0,FX_IO_ERROR=2,SD_CARD_STATUS_OK=0,SD_CARD_STATUS_BUSY=1,SD_CARD_STATUS_BACKPRESSURE=2,SD_CARD_STATUS_IO_ERROR=3};
#define SD_RAW_BATCH_MAX DAQ_RAW_BATCH_CAPACITY
#define SD_LINE_MAX 384U
#define SD_OPTIONAL_RAW_BACKLOG_LIMIT 256U

typedef struct {
 size_t tx_block_pool_block_size,tx_block_pool_total,tx_block_pool_available,budget;
 unsigned char *storage; unsigned occupied[1024];
} TX_BLOCK_POOL;

typedef struct{ULONG messages[1024][16];unsigned head,tail,count,words;}TX_QUEUE;
